  <joint name="joint1" type="revolute">
    <origin xyz="-1.04e-09 0 0.030249999" rpy="-3.1415927 0 0" />
    <parent link="base_link" />
    <child link="link1" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="28" velocity="5" />
  </joint>
  <!-- effort = 各关节电机的 tau_max（来自实机 ArmMpcJointConfig 配置）：
       joint1 DM4340P 28 / joint2 DM6248P 48 / joint3 DM6248P 48 /
       joint4 DM4310P 12.5 / joint5 DM4340P 28 / joint6 DM4310 12.5 N·m。
       原来的 10 N·m 只是占位值，而且在 Gazebo 里恰好卡住：拎着 0.4 kg
       物体抬升时，肘关节（joint3）的静力矩从 8.6 N·m 涨到 10.3 N·m，
       10 N·m 的限值让它在抬升约 0.11 m 处饱和，抬不上去。按实机 tau_max
       填写后 joint3 余量 4 倍以上。
       注意：仿真里没有重力补偿，全靠电机力矩硬顶，所以 effort 必须是
       电机的真实 tau_max，不能随手填小值。 -->
  <joint name="joint2" type="revolute">
    <origin xyz="0 -0.056875 -0.066" rpy="1.5707963 0 0" />
    <parent link="link1" />
    <child link="link2" />
    <axis xyz="0 0 1" />
    <limit lower="-2.5" upper="0.501" effort="48" velocity="5" />
  </joint>
