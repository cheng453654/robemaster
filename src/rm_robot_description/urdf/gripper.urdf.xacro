<?xml version="1.0"?>
<robot name="gripper" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 供 my_robot.urdf.xacro 拼接使用：所有 link/joint 自动加前缀，避免与机械臂重名 -->
  <xacro:property name="prefix" value="gripper_"/>

  <!-- 材质（motor/shell/bearing/structure/gripper）由 arm.urdf.xacro 统一定义，
       此处不再重复，否则 urdfdom 会报 "material is not unique" 而拒绝解析。
       需要单独显示夹爪时请用带材质定义的 gripper.urdf。 -->
